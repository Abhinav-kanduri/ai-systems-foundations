digraph G {graph [rankdir=LR,bgcolor="white",pad=.3];node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=13,fillcolor="#e5f4fa",color="#287da0"];edge [color="#427189",penwidth=1.5];Observe -> Predict -> Score -> Select -> Execute -> Observe;Observe[label="Observe Current State"];Predict[label="Predict H-Step Futures"]; Score[label="Score Risk and Reward"];Select[label="Choose First Action"];Execute[label="Execute Then Replan"];Execute -> Safety; Safety[label="Independent Safety Gate",fillcolor="#fff0ce",color="#d89b23"];Safety -> Stop[label="If unsafe",color="#d63333"];Stop[label="Emergency Stop",fillcolor="#ffe1e1",color="#d63333"]; }