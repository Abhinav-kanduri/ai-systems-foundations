digraph G { graph [rankdir=TB,bgcolor="white",pad=.3,nodesep=.35,ranksep=.48]; node [shape=box,style="rounded,filled",fillcolor="#e7f4fb",color="#326a9f",fontname="DejaVu Sans",fontsize=11,margin=".17,.12"]; edge [color="#42647e",arrowsize=.7]; Goal -> Sensors -> Perception -> State -> Model -> Candidates -> Evaluate -> Safe; Goal[label="Human / System Goal"];Sensors[label="Sensors and Environment"];Perception[label="Perception / State Estimation"];State[label="Belief State"]; Model[label="World Model: Predict Future States",fillcolor="#d6faf0",color="#099c87"]; Candidates[label="Candidate Action Sequences"];Evaluate[label="Reward, Risk, Constraints"];Safe[label="Safe and Feasible?",shape=diamond,fillcolor="#fff0ce",color="#d8a22e"]; Safe -> Replan[label="No"]; Replan -> Candidates; Safe -> Execute[label="Yes"]; Execute[label="Controller / Execute Action"]; Execute -> Observe -> Compare -> Error; Observe[label="Observe Reality"];Compare[label="Compare Prediction vs Observation"];Error[label="Prediction Error Acceptable?",shape=diamond,fillcolor="#fff0ce"];Error -> Achieved[label="Yes"];Error -> Critical[label="No"];Critical[label="Critical Failure?",shape=diamond,fillcolor="#fff0ce"];Critical -> Stop[label="Yes"];Stop[label="Emergency Stop / Safe Recovery",fillcolor="#ffdddd",color="#d63333"]; Critical -> Update[label="No"];Update[label="Update Model / State"];Update -> Perception;Achieved[label="Goal Achieved?",shape=diamond,fillcolor="#fff0ce"];Achieved -> Finish[label="Yes"];Finish[label="Complete Task",fillcolor="#d9f6e6"];Achieved -> Perception[label="No"]; }