digraph G { graph [rankdir=LR,bgcolor="white",pad=.35,nodesep=.4];node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=12,fillcolor="#e4efff",color="#326dc1"];edge [color="#567089",penwidth=1.3];Prompt -> Sim -> Frames;Prompt[label="Prompt / Actions"];Sim[label="Generative World Simulator"];Frames[label="Interactive Frames / Audio"];Data -> Dynamics -> Verify -> Controller;Data[label="Real Measurements",fillcolor="#e0f8f2",color="#0d937d"];Dynamics[label="Calibrated Physical Model",fillcolor="#e0f8f2",color="#0d937d"];Verify[label="Physics Validation / Error Bounds",fillcolor="#e0f8f2",color="#0d937d"];Controller[label="Constrained Planner + Safety",fillcolor="#e0f8f2",color="#0d937d"];Frames -> Verify [style=dashed,label="scenarios, not guarantees",color="#d19a28"]; }