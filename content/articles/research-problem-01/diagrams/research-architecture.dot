digraph G {graph [rankdir=LR,bgcolor="#09131f",pad=.3,ranksep=.55];node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontcolor="white",color="#36cbbb",fillcolor="#172637",fontsize=11,margin=".19,.14"];edge [color="#e9b44c",penwidth=1.8];P[label="Problem definition"];B[label="Baseline solver + corpus"];A[label="AI research agent"];C[label="Candidate algorithm"];T[label="Sandbox + tests"];X[label="Complexity analysis"];F[label="Theorem + proof"];L[label="Lean check (optional)"];R[label="Independent review"];P->B->A->C->T->X->F->L->R; T->A[label="counterexample",color="#e27877"];B->T;}