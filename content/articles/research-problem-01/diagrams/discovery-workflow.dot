digraph G { graph [rankdir=TB,bgcolor="#09131f",pad=.3,nodesep=.32,ranksep=.43]; node [shape=box,style="rounded,filled",fillcolor="#172637",color="#36cbbb",fontcolor="white",fontname="DejaVu Sans",fontsize=12,margin=".18,.12"]; edge [color="#e9b44c",penwidth=1.7,arrowsize=.7]; A[label="Computational problem: SAT"];B[label="Define inputs and constraints"];C[label="Analyze existing algorithms"];D[label="AI-assisted algorithm discovery"];E[label="Implement candidate"];F[label="Test easy and difficult cases"];G[shape=diamond,label="Tests pass?",fillcolor="#4d381a"];H[label="Worst-case complexity analysis"];I[label="Precise theorem and assumptions"];J[label="Mathematical proof"];K[label="Optional Lean formalization"];L[shape=diamond,label="Formal check passes?",fillcolor="#4d381a"];M[label="Independent scientific review"];N[label="Reproducible result",fillcolor="#134c48"];A->B->C->D->E->F->G;G->D[label="No",color="#e27877"];G->H[label="Yes"];H->I->J->K->L;L->I[label="No",color="#e27877"];L->M[label="Yes"];M->N;}