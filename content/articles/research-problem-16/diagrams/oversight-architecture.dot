digraph G {graph [rankdir=TB,bgcolor="#0b1220",pad=0.32,nodesep=0.35,ranksep=0.56]; node [shape=box,style="rounded,filled",fillcolor="#15243a",color="#31c9c3",fontcolor="white",fontname="DejaVu Sans",fontsize=12,margin="0.20,0.13"];edge [color="#92a7c7",arrowsize=0.7,fontcolor="#fbbf24",fontname="DejaVu Sans",fontsize=10]; A[label="Business decision request"];B[label="Collect primary evidence"];C[label="Define policy and risk criteria"];D[label="AI analysis agent"];E[label="Recommendation + uncertainty"];F[label="Independent risk assessment"];G[label="High risk or uncertain?",shape=diamond,fillcolor="#5e4219"];H[label="Authorized low-risk path"];I[label="Human review required",fillcolor="#13534d"];J[label="Show PRIMARY evidence first"];K[label="Record independent assessment"];L[label="Reveal AI recommendation"];M[label="Compare assessments"];N[label="Disagreement or missing evidence?",shape=diamond,fillcolor="#5e4219"];O[label="Investigate or escalate",fillcolor="#6a2536"];P[label="Human decision + rationale"];Q[label="Action authorized?",shape=diamond,fillcolor="#5e4219"];R[label="Execute approved action"];S[label="Reject or escalate",fillcolor="#6a2536"];T[label="Monitor decisions and outcomes"];U[label="Evaluate calibration and overreliance"];V[label="Improve review design"]; A->B->C->D->E->F->G; C->F;G->H[label="No"];G->I[label="Yes"];I->J->K->L->M->N;N->O[label="Yes"];O->J;N->P[label="No"];P->Q;Q->R[label="Yes"];Q->S[label="No"];H->T;R->T;S->T;T->U->V;}
