digraph G { graph [rankdir=TB,bgcolor="#0b1220",pad="0.4",nodesep="0.35",ranksep="0.48",fontname="DejaVu Sans"]; node [shape=box,style="rounded,filled",fillcolor="#172438",color="#42c9bc",fontcolor="#f3f7fb",fontname="DejaVu Sans",fontsize=12,margin="0.18,0.13"];edge [color="#8ba2b8",arrowsize=.7];
U[label="User request"]; A[label="Identity + permissions"]; Q[label="Retrieve candidate memories"]; EP[label="Episodic memory",shape=cylinder]; SE[label="Semantic knowledge",shape=cylinder]; DOC[label="Source documents",shape=cylinder]; P[label="Provenance + access checks"]; T[label="Temporal validity + supersession"]; V[label="Current and authorized?",shape=diamond,fillcolor="#49371e",color="#f4bb5c"]; C[label="Resolve conflicting evidence"]; F[label="Conflict resolved?",shape=diamond,fillcolor="#49371e",color="#f4bb5c"]; H[label="Clarify / authoritative source",fillcolor="#522833",color="#ee8585"]; B[label="Build verified working context"]; G[label="Agent plan + guarded execution"]; O[label="Independent outcome evaluation"]; N[label="Response + citations"]; M[label="Validate proposed memory update"]; W[label="Version / consolidate / audit"]; X[label="Reject or historical only",fillcolor="#522833",color="#ee8585"];
U->A->Q; EP->Q;SE->Q;DOC->Q;Q->P->T->V;V->X[label="no",fontcolor="#f3f7fb"]; V->C[label="yes",fontcolor="#f3f7fb"];C->F;F->H[label="no",fontcolor="#f3f7fb"];H->C;F->B[label="yes",fontcolor="#f3f7fb"];B->G->O->N->M->W; X->Q[style=dashed,constraint=false];W->SE[style=dashed,constraint=false];W->EP[style=dashed,constraint=false];}
