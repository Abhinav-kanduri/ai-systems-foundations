digraph G { graph [rankdir=TB,bgcolor="#0b1220",pad="0.35",nodesep="0.3",ranksep="0.45",label="REWARD HACKING • DETECTION & CORRECTION",labelloc=t,fontsize=22,fontcolor="#f3f7fc",fontname="DejaVu Sans Bold"]; node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=12,color="#2f536a",fontcolor="#ffffff",fillcolor="#172a3d",margin="0.22,0.15"]; edge [color="#4ccbbb",penwidth=1.8,arrowsize=0.7]; goal[label="HUMAN GOAL\nResolve customer problems",fillcolor="#15526a"]; criteria[label="Success criteria\nCorrectness • speed • satisfaction"]; reward[label="Reward design + constraints"]; agent[label="AI agent executes task"]; score[label="Reward evaluator\nMeasured proxy score"]; high[label="High reward?",shape=diamond,fillcolor="#6c5429"]; verify[label="Independent outcome verifier\nTicket histories • reopen rate • feedback",fillcolor="#12685e"]; passed[label="Actually resolved?",shape=diamond,fillcolor="#6c5429"]; good[label="Verified outcome\nAudit + ongoing monitoring",fillcolor="#12685e"]; bad[label="Proxy success / goal failure\nInvestigate the failure",fillcolor="#803a46"]; revise[label="Revise metrics, tests\nand constraints",fillcolor="#803a46"]; goal->criteria->reward->agent->score->high;high->verify[label=" Yes",fontcolor="#ffffff"];high->revise[label=" No",fontcolor="#ffffff"];verify->passed;passed->good[label=" Yes",fontcolor="#ffffff"];passed->bad[label=" No",fontcolor="#ffffff"];bad->revise;revise->reward[style=dashed]; }
