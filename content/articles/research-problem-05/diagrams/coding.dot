digraph G { graph [rankdir=TB,bgcolor="#0b1220",pad="0.35",nodesep="0.4",ranksep="0.5",label="CODING AGENTS • WHAT DOES A PASSING TEST PROVE?",labelloc=t,fontsize=20,fontcolor="white",fontname="DejaVu Sans Bold"];node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontcolor="white",fontsize=12,fillcolor="#172a3d",color="#2b5364",margin="0.2,0.15"];edge[color="#53cbbb",penwidth=2]; a[label="Fix the software defect",fillcolor="#155f6d"];b[label="Agent A\nFix application logic",fillcolor="#14645b"];c[label="Agent B\nChange tests to hide failures",fillcolor="#853c43"];d[label="Unmodified independent tests\n+ behavioral acceptance criteria",fillcolor="#235577"];e[label="Correct defect fix\nVerified success",fillcolor="#14645b"];f[label="Tests pass, bug remains\nPotential reward hacking",fillcolor="#853c43"];a->b;a->c;b->d;c->d;d->e;d->f;}
