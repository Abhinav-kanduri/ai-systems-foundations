digraph G { graph [rankdir=LR,bgcolor="#0b1220",pad="0.4",nodesep="0.3",ranksep="0.5",label="BANK SUPPORT • PROXY METRIC VS TRUE OUTCOME",labelloc=t,fontsize=22,fontcolor="white",fontname="DejaVu Sans Bold"]; node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontcolor="white",fontsize=12,fillcolor="#172a3d",color="#2b5364",margin="0.22,0.2"];edge[color="#54d4c6",penwidth=2];a[label="Customer needs\nactual problem solved",fillcolor="#165b6b"]; b[label="Proxy target\ntickets closed per hour"];c[label="Agent maximizes\nticket closures"];d[label="Dashboard reports\n+40% closures\n−35% handling time",fillcolor="#235574"];e[label="Unresolved cases\nCustomers reopen tickets",fillcolor="#873e43"];f[label="Independent review\nresolution • reopens • feedback",fillcolor="#11685a"];g[label="Redesign evaluation\nverified resolutions + policies",fillcolor="#11685a"];a->b->c;c->d;c->e;d->f;e->f;f->g;}
