digraph G {rankdir=TB;bgcolor="transparent";nodesep=.3;ranksep=.48;node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=12,margin=".25,.13",fillcolor="#E6F2F1",color="#0D9488"];edge [color="#64748B",arrowsize=.7];a[label="Candidate causal hypothesis"];b[label="Check source validity"];c[label="Assess confounding / alternative explanations"];d[label="Pre-register experiment and criteria"];e[label="Human scientist / ethics approval",fillcolor="#FFF2D6",color="#D59A21"];f[label="Conduct controlled experiment"];g[label="Assess effect size, uncertainty, reproducibility"];h[label="Prediction supported?",shape=diamond,fillcolor="#FFF2D6",color="#D59A21"];i[label="Refine hypothesis and repeat"];j[label="Qualified finding with full provenance",fillcolor="#DCFCE7",color="#16A34A"];a->b->c->d->e->f->g->h;h->i[label="Not yet"];i->d[constraint=false];h->j[label="Supported"];}