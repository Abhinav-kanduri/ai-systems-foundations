digraph G { rankdir=TB; splines=polyline; nodesep=.33; ranksep=.62; bgcolor="transparent"; graph [fontname="DejaVu Sans"]; node [shape=box,style="rounded,filled",color="#0D9488",fillcolor="#E6F2F1",fontcolor="#134E4A",fontname="DejaVu Sans",fontsize=12,margin=".20,.13"]; edge [color="#64748B",arrowsize=.65,penwidth=1.5,fontname="DejaVu Sans",fontsize=10]; q[label="Scientific research question",fillcolor="#E0E7FF",color="#6366F1"]; c[label="Research coordinator agent"]; l[label="Literature research agent"]; d[label="Data analysis agent"]; h[label="Hypothesis generation agent"]; x[label="Experimental design agent"]; pub[label="Scientific publications",shape=cylinder]; ds[label="Research datasets",shape=cylinder]; e[label="Evidence synthesis"]; v[label="Independent verification agent"]; k[label="Candidate hypotheses"]; t[label="Proposed experiments"]; g[label="Evidence sufficient?",shape=diamond,fillcolor="#FFF2D6",color="#D59A21"]; r[label="Identify gaps and revise hypotheses",fillcolor="#FFF2D6",color="#D59A21"]; u[label="Human scientist review",fillcolor="#FFF2D6",color="#D59A21"]; b[label="Laboratory / real-world experiments",fillcolor="#FFF2D6",color="#D59A21"]; f[label="Evaluate experimental results",fillcolor="#FFF2D6",color="#D59A21"]; n[label="Scientific findings",fillcolor="#DCFCE7",color="#16A34A"]; q->c; c->{l d h x};pub->l;ds->d;l->e;d->e;h->k;x->t;k->e;t->e;e->v;v->g;g->r[label="No"];r->c[constraint=false];g->u[label="Yes, for review"];u->b;b->f;f->n;f->c[label="New evidence",constraint=false]; {rank=same;l;d;h;x} }