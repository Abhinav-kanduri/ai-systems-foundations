# Environment configuration
APP_ENV=local
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE="Reliable Multi-Agent Loan Underwriting System"

# Database
DATABASE_URL=sqlite:///./underwriting.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/underwriting

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your-api-key-here
MODEL_NAME=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-small

# Workflow Configuration
MAX_AGENT_STEPS=12
MAX_TOOL_RETRIES=3
MAX_WORKFLOW_DURATION_SECONDS=300
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.75

# Observability
TRACE_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# Security
ENABLE_CORS=true
CORS_ORIGINS=["*"]
API_KEY_REQUIRED=false

# Feature Flags
ENABLE_HUMAN_REVIEW=true
ENABLE_AUDIT_LOGGING=true
ENABLE_PERFORMANCE_METRICS=true
